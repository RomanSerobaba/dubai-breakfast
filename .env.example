# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram bot API token for lead notifications
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# TELEGRAM_CHAT_ID: Telegram chat ID where lead notifications will be sent
TELEGRAM_CHAT_ID="MY_TELEGRAM_CHAT_ID"

# GOOGLE RECAPTCHA V2 KEYS
RECAPTCHA_SITE_KEY="MY_RECAPTCHA_SITE_KEY"
RECAPTCHA_SECRET_KEY="MY_RECAPTCHA_SECRET_KEY"
VITE_RECAPTCHA_SITE_KEY="MY_RECAPTCHA_SITE_KEY"
